# 生产环境配置示例：复制到项目根目录为 .env 后按需修改
#   cp deploy/env.production.example .env

# ===== 模型提供商 =====
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=sk-换成你的key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
# 智谱（可选）
BIGMODEL_API_KEY=
BIGMODEL_BASE_URL=https://open.bigmodel.cn/api/paas/v4
BIGMODEL_MODEL=glm-4.7-flash

# ===== 通用参数 =====
LLM_TIMEOUT_MS=180000
LLM_STREAM_IDLE_MS=60000
LLM_MAX_RETRIES=2
JD_EXTRACT=true
CACHE_ENABLED=true
CACHE_TTL_HOURS=24
LOG_REQUESTS=true

# ===== 服务 =====
# 对外部署：监听所有网卡（由 Caddy 反代到 127.0.0.1:3001）
HOST=0.0.0.0
PORT=3001
# 换成你的域名（用于 CORS 白名单）
CORS_ORIGINS=https://your-domain.com
MAX_CONCURRENCY=5
MAX_QUEUE=50

# ===== 鉴权（务必修改）=====
# 生成：openssl rand -hex 32
AUTH_SECRET=change-me-to-a-long-random-string
AUTH_TOKEN_TTL=7d
# 启用 HTTPS 后必须设为 true
COOKIE_SECURE=true
DAILY_LIMIT=30
REGISTRATION_OPEN=true
