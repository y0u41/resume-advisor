# 简历评估助手 反向代理配置
# 将 your-domain.com 换成你的域名；Caddy 会自动申请并续期 HTTPS 证书
#
# 用法（Linux 服务器）：
#   1) 安装 Caddy：https://caddyserver.com/docs/install
#   2) 把本文件放到 /etc/caddy/Caddyfile（域名改成你的）
#   3) sudo systemctl reload caddy

your-domain.com {
	# 压缩（SSE 事件流不会被压缩，Caddy 会自动跳过）
	encode gzip zstd

	# 反代到本机 Node 服务
	reverse_proxy 127.0.0.1:3001 {
		# 评估是 SSE 流式，必须立即刷新，否则前端会“卡住”直到结束
		flush_interval -1
	}

	# 隐藏 Server 头
	header {
		-Server
	}
}
