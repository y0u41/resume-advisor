# ===== 模型提供商 =====
# 当前使用哪家：deepseek 或 bigmodel（对应下方 <提供商>_ 前缀）
LLM_PROVIDER=deepseek

# DeepSeek（https://platform.deepseek.com/api_keys）
DEEPSEEK_API_KEY=your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 可用模型：deepseek-v4-flash（快/省） / deepseek-v4-pro（强）
DEEPSEEK_MODEL=deepseek-v4-flash

# 智谱 BigModel（https://open.bigmodel.cn）
BIGMODEL_API_KEY=your-bigmodel-key
BIGMODEL_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# 可用模型：glm-5.3（旗舰） / glm-4.6 / glm-4.7-flash（免费） / glm-4.5-flash（免费）
BIGMODEL_MODEL=glm-4.7-flash

# ===== 通用参数 =====
# LLM 请求超时（毫秒）；大模型（如 glm-4.6 / glm-5.3）较慢，可调大
LLM_TIMEOUT_MS=180000
# 流式响应无数据的停滞超时（毫秒），超时自动回退非流式
LLM_STREAM_IDLE_MS=60000
# 失败自动重试次数（限流 / 5xx / 超时）
LLM_MAX_RETRIES=2
# 是否关闭推理模型的「思考」链（reasoning_content）。
# 默认关闭：DeepSeek 新推理模型会先输出大量思维链，可能耗尽 max_tokens 导致正文为空。
# 如需恢复思考：LLM_THINKING=enabled（仅对 DeepSeek 生效，其它提供商不受影响）
LLM_THINKING=disabled
# 链接抓取后是否用 LLM 智能提取岗位重点信息
JD_EXTRACT=true

# ===== 套餐与额度（详见 docs/定价与额度.md）=====
# 免费档：默认走免费的 GLM-Flash（成本≈0），日额度给足作为获客手段
FREE_DAILY_LIMIT=100
FREE_PREMIUM_DAILY=5
FREE_OCR_DAILY=3
# 免费档默认模型（未配置则回退 LLM_PROVIDER 的默认）
FREE_DEFAULT_PROVIDER=bigmodel
FREE_DEFAULT_MODEL=glm-4.7-flash
# PRO：¥9.9/月（仅展示）；额度更高、高级模型更多；PRO_OCR_DAILY=0 表示不限
PRO_DAILY_LIMIT=500
PRO_PREMIUM_DAILY=30
PRO_OCR_DAILY=0
PRO_PRICE=9.9
# PRO 单次开通 / 续费的时长（月），管理员批准或手动开通时写入 plan_expires_at
PRO_PERIOD_MONTHS=1
# PRO 支付方式（支付网关接入前的最简闭环：收款码 + 付款后填邮箱 + 管理员开通）
# 收款码图片地址（站内路径如 /pay-qr.png，或 data:image/...）；留空则只提示"提交申请、管理员联系收款"
PRO_PAY_QR=
# 外部支付链接（有赞 / 爱发电等），点按新窗口打开
PRO_PAY_URL=
# 补充说明（如"转账后请填写邮箱"）
PRO_PAY_NOTE=
PRO_DEFAULT_PROVIDER=deepseek
PRO_DEFAULT_MODEL=deepseek-v4-flash

# ===== 游客转化实验（A/B，按 IP 稳定分桶；未配置=单组）=====
# 试用次数两组，如 "3,5"
GUEST_AB_LIMITS=
# 预览字数两组，如 "800,1500"
GUEST_AB_PREVIEW=
# 单组默认（未开实验时生效）
GUEST_LIMIT=3
GUEST_PREVIEW_CHARS=800
# 高级（高成本）模型：计入 premium 额度，不占用普通额度
PREMIUM_MODELS=deepseek-v4-pro,glm-4.6,glm-5.3

# ===== 报告解析健康度（ADR-0007 量化触发器）=====
# 近 PARSE_WINDOW_DAYS 天，解析降级率 > PARSE_DEGRADE_THRESHOLD 且样本 >= PARSE_MIN_SAMPLES 时，
# 后台「报告解析健康度」提示启用「尾部机器可读块」。见 docs/adr/0007-report-format-stays-text.md
PARSE_WINDOW_DAYS=7
PARSE_DEGRADE_THRESHOLD=0.05
PARSE_MIN_SAMPLES=200

# 结果缓存：相同输入在有效期内直接返回（省时省钱）
CACHE_ENABLED=true
CACHE_TTL_HOURS=24

# ===== 岗位关键词库（SEO）=====
# 站点绝对地址（canonical / sitemap 用）；有域名后设置，如 https://example.com
SITE_URL=
# 冷启动门槛：数据不足的分类/全站不发布、noindex，避免薄内容页拉低 SEO 权重
KEYWORDS_MIN_JD=5
KEYWORDS_MIN_KEYWORDS=10
KEYWORDS_MIN_TOTAL_JD=20
# 是否输出请求日志
LOG_REQUESTS=true

# ===== 服务 =====
PORT=3001
# 监听地址：默认仅本机。对外部署时改 0.0.0.0（并配合反向代理 + HTTPS）
HOST=127.0.0.1
# 信任的代理层数：反向代理（Caddy/Nginx）后设 1，才能取到真实客户端 IP（游客限流/速率限制依赖）；
# 直连（无代理）必须为 0（默认），否则客户端可伪造 X-Forwarded-For 无限刷游客试用，转化数据失真。
TRUST_PROXY=0
# 允许的跨域来源（逗号分隔）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 同时进行的评估数上限，超出排队
MAX_CONCURRENCY=5
# 排队队列上限，超出则拒绝
MAX_QUEUE=50

# ===== 鉴权（多用户）=====
# 生产环境务必设置为随机长字符串（例如：openssl rand -hex 32）
AUTH_SECRET=change-me-to-a-long-random-string
# 登录态有效期
AUTH_TOKEN_TTL=7d
# Cookie 是否仅走 HTTPS（对外部署启用 HTTPS 后设为 true）
COOKIE_SECURE=false
# 是否开放注册（false 则只能由已有用户邀请/手动建号）
REGISTRATION_OPEN=true

# ===== 分享 =====
# 分享链接有效期（天），默认 30
SHARE_TTL_DAYS=30

# ===== 成本看板 =====
# 估算单价（¥ / 1M tokens），JSON；不设则用内置示例价
# 例：{"deepseek-v4-flash":{"in":1,"out":2},"glm-5.3":{"in":4,"out":16}}
# LLM_PRICE_JSON={"deepseek-v4-flash":{"in":1,"out":2}}
