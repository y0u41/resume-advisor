# LLM API 配置
# 默认使用 DeepSeek 官方接口（在 https://platform.deepseek.com/api_keys 获取 Key）
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://api.deepseek.com
# 可用模型：deepseek-v4-flash（快/省） / deepseek-v4-pro（强） / deepseek-v4-flash-vision-exp
LLM_MODEL=deepseek-v4-flash
# LLM 请求超时（毫秒）
LLM_TIMEOUT_MS=120000
# 流式响应无数据的停滞超时（毫秒）
LLM_STREAM_IDLE_MS=45000
# 链接抓取后是否用 LLM 智能提取岗位重点信息
JD_EXTRACT=true

# 服务配置
PORT=3001
# 监听地址：默认仅本机。对外部署时改 0.0.0.0（并配合反向代理 + HTTPS）
HOST=127.0.0.1
# 允许的跨域来源（逗号分隔）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 鉴权（多用户）
# 生产环境务必设置为随机长字符串（例如：openssl rand -hex 32）
AUTH_SECRET=change-me-to-a-long-random-string
# 登录态有效期
AUTH_TOKEN_TTL=7d
# Cookie 是否仅走 HTTPS（对外部署启用 HTTPS 后设为 true）
COOKIE_SECURE=false
# 每人每日评估次数上限
DAILY_LIMIT=30
# 是否开放注册（false 则只能由已有用户邀请/手动建号）
REGISTRATION_OPEN=true
